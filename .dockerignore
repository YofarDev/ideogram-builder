# Keep the build context limited to files copied by the worker Dockerfiles.
*
!runpod/
runpod/*
!runpod/handler.py
!runpod/workflow_template_lora.json
!runpod/workflow_template_lora_turbo.json
!runpod/workflow_template_moss.json
!runpod/moss_config.py
!runpod/moss_workflow.py
!runpod/moss_assets.py
!runpod/comfy_metrics.py
!runpod/moss_benchmark.py
!runpod/runtime_check.py
!runpod/moss_cache.py
!runpod/moss_memory.py
!runpod/moss_benchmark_worker.py
!runpod/moss-models.json
!runpod/moss-runtime.lock.json
!runpod/custom_nodes/
runpod/custom_nodes/*
!runpod/custom_nodes/moss_runtime/
runpod/custom_nodes/moss_runtime/*
!runpod/custom_nodes/moss_runtime/__init__.py
!runpod/benchmarks/
runpod/benchmarks/*
!runpod/benchmarks/moss/
runpod/benchmarks/moss/*
!runpod/benchmarks/moss/fixtures.json
